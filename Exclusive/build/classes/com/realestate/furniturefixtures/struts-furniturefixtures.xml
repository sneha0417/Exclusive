<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	

	<package name="furniturefixtures" extends="struts-default">
			<action name="saveFurnitureFixtures" class="com.realestate.furniturefixtures.ClsFurnitureFixturesAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >furniturefixtures.jsp</result>
				<result name="fail">furniturefixtures.jsp</result>
			</action>			
		</package>	
</struts>