<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
<constant name="struts.devMode" value="false" />
	<package name="maintenancerequest" extends="struts-default">
			<action name="saveMaintenancerequest" class="com.realestate.maintenancerequest.ClsMaintenanceRequestAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success">maintenancerequest.jsp</result>
				<result name="fail">maintenancerequest.jsp</result>
			</action>

		</package>	
		
</struts>