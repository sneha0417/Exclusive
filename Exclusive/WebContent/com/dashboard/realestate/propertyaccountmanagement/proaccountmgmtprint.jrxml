	<parameter name="pacno" class="java.lang.String"/>
	<parameter name="fromdate" class="java.sql.Date"/>
	<parameter name="todate" class="java.sql.Date"/>
	<queryString>
		<![CDATA[select if(round(sum(a.dueamount)-sum(a.deductions),2)=0,'',round(sum(a.dueamount)-sum(a.deductions),2)) total from (select 1 rowno,round((if(sum(dramount)>0,sum(dramount),0)),2) deductions, round((if(sum(dramount)<0,sum(dramount)*-1,0)),2) dueamount from my_jvtran where status=3 and  date < $P{fromdate} and acno=$P{pacno}  and dramount!=0 group by acno union all 
		select 1 rowno,round(if(dramount>0,dramount,0),2) deductions, round(if(dramount<0,dramount*id,0),2) dueamount from my_jvtran where status=3 and date between $P{fromdate} and $P{todate} and acno=$P{pacno} union all select 1 rowno,0 deductions, 0 dueamount) a group by rowno;]]>
	</queryString>
	<field name="total" class="java.math.BigDecimal"/>
