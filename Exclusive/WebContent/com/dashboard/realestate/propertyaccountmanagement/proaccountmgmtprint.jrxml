	<subDataset name="Dataset1" uuid="15d19f05-7844-4d20-878c-111ab5dc1519">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (7)"/>
		<parameter name="pacno" class="java.lang.String"/>
		<parameter name="fromdate" class="java.sql.Date"/>
		<parameter name="todate" class="java.sql.Date"/>
		<queryString>
			<![CDATA[select @i:=@i+1 srno,a.date,a.description,if(a.pdcheld=0 or a.pdcheld=0.00,'',format(a.pdcheld,2)) pdcheldstr,if(a.deductions=0 or a.deductions=0.00,'',format(a.deductions,2)) dedctstr,if(a.dueamount=0 or a.dueamount=0.00,'',format(a.dueamount,2)) duestr,a.pdcheld,a.deductions,a.dueamount from (
select $P{fromdate} date,'Opening' description, round(0,2) pdcheld, round((if(sum(dramount)>0,sum(dramount),0)),2) deductions, round((if(sum(dramount)<0,sum(dramount)*-1,0)),2) dueamount from my_jvtran where status=3 and date < $P{fromdate} and acno=$P{pacno} and dramount!=0 group by acno having sum(dramount)<>0 union all 
select * from (
select * from (
select date,description, round(0,2) pdcheld, round(if(dramount>0,dramount,0),2) deductions, round(if(dramount<0,dramount*id,0),2) dueamount from my_jvtran where  status=3 and date between $P{fromdate} and $P{todate} and acno=$P{pacno} and id<0 order by date) aa union all
select null date,'Deduction' description,0 pdcheld,0 deductions,0 dueamount union all
select * from (
select date,description, round(0,2) pdcheld, round(if(dramount>0,dramount,0),2) deductions, round(if(dramount<0,dramount*id,0),2) dueamount from my_jvtran where  status=3 and date between $P{fromdate} and $P{todate} and acno=$P{pacno} and id>0 order by date) bb ) b
union all select p.date,p.desc1 description,round(p.pamount,2) pdcheld,round(0,2) deductions,round(0,2) dueamount from rl_tncpayment p left join rl_tncm m on p.rdocno=m.doc_no left join rl_propertymaster pr on pr.doc_no=m.prtype where pr.acno=$P{pacno} and p.desc1='Rental value' and ownerpytsettletrno=0 and payment='bank' and paidto='self' and p.refno=0 and m.status=3 
union all select date,description,round(dramount,2)*id  ,0,0 from my_jvtran where status=3 and acno=$P{pacno} and dramount<0 and date>$P{todate}    ) a,(select @i:=0)c;]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="date" class="java.sql.Date"/>
		<field name="description" class="java.lang.String"/>
		<field name="pdcheldstr" class="java.lang.String"/>
		<field name="dedctstr" class="java.lang.String"/>
		<field name="duestr" class="java.lang.String"/>
		<field name="pdcheld" class="java.math.BigDecimal"/>
		<field name="deductions" class="java.math.BigDecimal"/>
		<field name="dueamount" class="java.math.BigDecimal"/>
		<variable name="pdctot" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{pdcheld}]]></variableExpression>
		</variable>
		<variable name="dedtot" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{deductions}]]></variableExpression>
		</variable>
		<variable name="duetot" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{dueamount}]]></variableExpression>
		</variable>
	</subDataset>
