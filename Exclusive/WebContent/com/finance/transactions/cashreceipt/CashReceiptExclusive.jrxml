	<subDataset name="Accounting" uuid="fc3f9e62-ae3d-4b5b-ba6e-29e7ebfd1c54">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="AITS_new"/>
		<parameter name="doc" class="java.lang.Integer"/>
		<parameter name="brch" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[select @i:=@i+1 srno,b.* from (SELECT t.account,t.description accountname,c.code currency,d.description,
if(d.amount>0,format(round((d.amount*1),2),2),'  ') debit,if(d.amount<0,format(round((d.amount*-1),2),2),' ') credit
 FROM my_cashbm m left join my_cashbd d on m.tr_no=d.tr_no
					left join my_head t on d.acno=t.doc_no left join my_curr c on c.doc_no=d.curId WHERE
           m.dtype='CRV' and m.brhid=$P{brch} and m.doc_no=$P{doc} order by d.amount desc)b,(select @i:=0)c;]]>
		</queryString>
		<field name="srno" class="java.lang.String"/>
		<field name="account" class="java.lang.String"/>
		<field name="accountname" class="java.lang.String"/>
		<field name="currency" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="debit" class="java.lang.String"/>
		<field name="credit" class="java.lang.String"/>
	</subDataset>
