	<subDataset name="pettycashgrid" uuid="6b0db19c-2c92-4a4a-aa3f-e7ee8d1f4ff3">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter "/>
		<parameter name="doc" class="java.lang.Integer"/>
		<parameter name="brch" class="java.lang.Integer"/>
		<parameter name="debtot" class="java.lang.String"/>
		<parameter name="credtot" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT t.account,t.description accountname,j.description accdesc,c.code currency,if(j.dramount>0,round((j.dramount*1),2),'  ') debit,
		if(j.dramount<0,round((j.dramount*-1),2),'  ') credit FROM my_jvma m left join my_jvtran j on m.tr_no=j.tr_no 
		left join my_head t on j.acno=t.doc_no left join my_curr c on c.doc_no=j.curId WHERE m.dtype='JVT' and m.brhid=$P{brch} 
		and m.doc_no=$P{doc} order by j.dramount desc;]]>
		</queryString>
		<field name="account" class="java.lang.String"/>
		<field name="accountname" class="java.lang.String"/>
		<field name="accdesc" class="java.lang.String"/>
		<field name="currency" class="java.lang.String"/>
		<field name="debit" class="java.lang.String"/>
		<field name="credit" class="java.lang.String"/>
	</subDataset>
