	<queryString>
		<![CDATA[select ' name' as name,br.branchname,bk.logo as logoname,bk.account bankaccount,bk.address bankaddress,bk.beneficiary,bk.ibanno,bk.name bankname,bk.swiftcode from my_chqbm inv LEFT JOIN cm_bankdetails bk ON inv.brhid=bk.brhid AND bk.status=3 left join my_brch br on inv.brhid=br.doc_no and br.status=3 where inv.doc_no=$P{doc} and inv.dtype='BPV' and inv.brhId=$P{brch};]]>
	</queryString>
	<field name="name" class="java.lang.String"/>
